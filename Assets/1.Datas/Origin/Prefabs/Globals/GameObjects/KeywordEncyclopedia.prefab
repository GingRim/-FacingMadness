--- !u!114 &9143777782749155128
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 533993362679008751}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b64ac168ae7af7d4da989ae14433f6cc, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::KeywordEncyclopedia
  cardButton: {fileID: 7039741857159185427}
  effectButton: {fileID: 2070493139113098959}
  etcButton: {fileID: 1334420429282297638}
  core: {fileID: 8429727569979245284}
  buttonTemplate: {fileID: 2504780862936574309}
  keywordInfo: {fileID: 7939602685406254669}
  cardEntries:
  - buttonName: "\uC801\uC0C9<br>\uC804\uD22C"
    displayName: "\uC801\uC0C9 \uCE74\uB4DC \uC804\uD22C \uD6A8\uACFC"
    description: "\uC9C0\uC815 : \uC801<br>\uD589\uB3D9 \uCF54\uC2A4\uD2B8<br>1D10
      + (\uADFC\uB825 \uBCF4\uC815\uCE58) \uADFC\uC811 \uD53C\uD574<br>\uBCF4\uC870
      \uD589\uB3D9 \uCF54\uC2A4\uD2B8<br>1D8 \uADFC\uC811 \uD53C\uD574<br>\uD06C\uB9AC\uD2F0\uCEEC<br>\uD589\uB3D9
      \uCF54\uC2A4\uD2B8<br>1D10  \uCD94\uAC00<br>\uBCF4\uC870 \uD589\uB3D9<br>(\uADFC\uC811
      \uBCF4\uC815\uCE58) \uCD94\uAC00<br>\uC0C1\uC704 \uD06C\uB9AC\uD2F0\uCEEC<br>\uD589\uB3D9
      \uCF54\uC2A4\uD2B8<br>\uAE30\uC874 \uD6A8\uACFC + (\uADFC\uC811 \uBCF4\uC815\uCE58
      X 2) \uBCC0\uACBD<br>\uBCF4\uC870 \uD589\uB3D9 \uCF54\uC2A4\uD2B8<br>\uAE30\uC874
      \uD6A8\uACFC + 1D8 \uCD94\uAC00"
  - buttonName: "\uC801\uC0C9<br>\uD544\uB4DC"
    displayName: "\uC801\uC0C9 \uCE74\uB4DC \uD544\uB4DC \uD6A8\uACFC"
    description: "\uC774\uB3D9 \uBD88\uAC00<br>\uC801\uC0C9 \uB8E8\uD2B8<br>\uD574\uBC29"
  - buttonName: "\uD669\uC0C9<br>\uC804\uD22C"
    displayName: "\uD669\uC0C9 \uCE74\uB4DC \uC804\uD22C \uD6A8\uACFC"
    description: "\uC9C0\uC815 : \uC801<br>\uD589\uB3D9 \uCF54\uC2A4\uD2B8<br>1D10
      \uADFC\uC811 \uD53C\uD574<br>\uD06C\uB9AC\uD2F0\uCEEC<br>1D10 + 1D6 \uCD94\uAC00<br>\uC0C1\uC704
      \uD06C\uB9AC\uD2F0\uCEEC<br>\uAE30\uC874 \uD6A8\uACFC + 1D10 + 1D6 \uCD94\uAC00<br>\uC9C0\uC815
      : \uD300<br>1D4 \uB9CC\uD07C \uAC00\uC18D \uD68D\uB4DD<br>\uD06C\uB9AC\uD2F0\uCEEC,
      \uC0C1\uC704 \uD06C\uB9AC\uD2F0\uCEEC X"
  - buttonName: "\uD669\uC0C9<br>\uD544\uB4DC"
    displayName: "\uD669\uC0C9 \uCE74\uB4DC \uD544\uB4DC \uD6A8\uACFC"
    description: "\uC778\uC811\uD55C \uAD6C\uC5ED\uC744<br>1\uD68C \uB6F0\uC5B4<br>\uB118\uC744
      \uC218 \uC788\uB2E4."
  - buttonName: "\uB179\uC0C9<br>\uC804\uD22C"
    displayName: "\uB179\uC0C9 \uCE74\uB4DC \uC804\uD22C \uD6A8\uACFC"
    description: "\uC9C0\uC815 : \uC790\uC2E0<br>\uD589\uB3D9 \uCF54\uC2A4\uD2B8<br>1D10
      + (\uAC74\uAC15 \uBCF4\uC815\uCE58) \uB9CC\uD07C \uC0DD\uBA85\uB825 \uD68C\uBCF5<br>\uD06C\uB9AC\uD2F0\uCEEC<br>
      +5 \uC0DD\uBA85\uB825 \uD68C\uBCF5<br> +15 \uC0DD\uBA85\uB825 \uD68C\uBCF5\uC73C\uB85C
      \uBCC0\uACBD<br>\uC9C0\uC815 : \uD300<br>\uBCF4\uC870 \uD589\uB3D9<br>1D4 \uB9CC\uD07C
      \uC784\uC2DC \uC7A5\uAC11 \uD68D\uB4DD<br>\uD06C\uB9AC\uD2F0\uCEEC<br>1D4 \uCD94\uAC00<br>\uC0C1\uC704
      \uD06C\uB9AC\uD2F0\uCEEC<br>1D4 -> 1D8 \uBCC0\uACBD"
  - buttonName: "\uB179\uC0C9<br>\uD544\uB4DC"
    displayName: "\uB179\uC0C9 \uCE74\uB4DC \uD544\uB4DC \uD6A8\uACFC"
    description: "<br><br><br>1D6 + (\uAC74\uAC15 \uBCF4\uC815\uCE58)<br>\uB9CC\uD07C<br>\uC0DD\uBA85\uB825
      + \uC815\uC2E0\uB825 \uD68C\uBCF5<br><br><br><br>"
  - buttonName: "\uCCAD\uC0C9<br>\uC804\uD22C"
    displayName: "\uCCAD\uC0C9 \uCE74\uB4DC \uC804\uD22C \uD6A8\uACFC"
    description: "\uC9C0\uC815 : \uC801<br>\uD589\uB3D9 \uCF54\uC2A4\uD2B8<br>1D10
      \uC6D0\uAC70\uB9AC \uD53C\uD574<br>\uD06C\uB9AC\uD2F0\uCEEC<br>(\uC9C0\uB825
      \uBCF4\uC815\uCE58) \uCD94\uAC00<br>\uC0C1\uC704 \uD06C\uB9AC\uD2F0\uCEEC<br>\uAE30\uC874
      \uD6A8\uACFC + 1D10 \uCD94\uAC00<br>\uC9C0\uC815 : \uD300<br>\uBCF4\uC870 \uD589\uB3D9
      \uCF54\uC2A4\uD2B8<br>50% 2\uB4DC\uB85C\uC6B0 / 50% \uC758\uC695 1D4 \uBD80\uC5EC<br>\uD06C\uB9AC\uD2F0\uCEEC,
      \uC0C1\uC704 \uD06C\uB9AC\uD2F0\uCEEC X"
  - buttonName: "\uCCAD\uC0C9<br>\uD544\uB4DC"
    displayName: "\uCCAD\uC0C9 \uCE74\uB4DC \uD544\uB4DC \uD6A8\uACFC"
    description: "\uC778\uC811\uD55C \uAD6C\uC5ED<br>\uD0D0\uC0C9<br>\uC815\uBCF4
      \uD68D\uB4DD<br>\uD788\uB4E0 \uAD6C\uC5ED \uD655\uC778"
  - buttonName: "\uC790\uC0C9<br>\uC804\uD22C"
    displayName: "\uC790\uC0C9 \uCE74\uB4DC \uC804\uD22C \uD6A8\uACFC"
    description: "\uC9C0\uC815 : X<br>\uD589\uB3D9 + \uBCF4\uC870 \uD589\uB3D9 \uCF54\uC2A4\uD2B8<br>10%
      \uAE08\uC9C0\uB41C \uB9C8\uBC95 \uC0DD\uC131<br>30% \uB9C8\uBC95 : \uACF5\uACA9
      \uC0DD\uC131<br>30% \uB9C8\uBC95 : \uBC29\uC5B4 \uC0DD\uC131<br>30% \uB9C8\uBC95
      : \uBC84\uD504 \uC0DD\uC131<br>\uD06C\uB9AC\uD2F0\uCEEC, \uC0C1\uC704 \uD06C\uB9AC\uD2F0\uCEEC
      X"
  - buttonName: "\uC790\uC0C9<br>\uD544\uB4DC"
    displayName: "\uC790\uC0C9 \uCE74\uB4DC \uD544\uB4DC \uD6A8\uACFC"
    description: "\uC2E0\uD654 \uD134\uC744<br>1D6 \uB9CC\uD07C<br>\uBBF8\uB8F9\uB2C8\uB2E4."
  - buttonName: "\uBB34\uC0C9<br>\uC804\uD22C"
    displayName: "\uBB34\uC0C9 \uCE74\uB4DC \uC804\uD22C \uD6A8\uACFC"
    description: "\uC9C0\uC815 : \uC801<br>\uD589\uB3D9 \uCF54\uC2A4\uD2B8<br>\uBB34\uC0C9
      \uC8FC\uC0AC\uC704 \uB9CC\uD07C \uADFC\uC811 \uD53C\uD574<br>\uD06C\uB9AC\uD2F0\uCEEC<br>\uBB34\uC0C9
      \uC8FC\uC0AC\uC704 \uCD94\uAC00<br>\uC0C1\uC704 \uD06C\uB9AC\uD2F0\uCEEC<br>\uBB34\uC0C9
      \uC8FC\uC0AC\uC704\uB97C -> 1D10 \uBCC0\uACBD<br>\uC9C0\uC815 : \uC790\uC2E0<br>\uBCF4\uC870
      \uD589\uB3D9<br>\uBB34\uC0C9 \uC8FC\uC0AC\uC704 \uB9CC\uD07C \uC0DD\uBA85\uB825
      + \uC815\uC2E0\uB825 \uD68C\uBCF5<br>\uD06C\uB9AC\uD2F0\uCEEC<br>\uBB34\uC0C9
      \uC8FC\uC0AC\uC704 \uCD94\uAC00<br>\uC0C1\uC704 \uD06C\uB9AC\uD2F0\uCEEC<br>\uBB34\uC0C9
      \uC8FC\uC0AC\uC704 -> 1D10 \uBCC0\uACBD + 5 \uCD94\uAC00"
  - buttonName: "\uBB34\uC0C9<br>\uD544\uB4DC"
    displayName: "\uBB34\uC0C9 \uCE74\uB4DC \uD544\uB4DC \uD6A8\uACFC"
    description: "\uD2B9\uC815 \uC0C9 \uCE74\uB4DC\uB97C \uB300\uC2E0\uD558\uC5EC<br>\uADF8
      \uC0C9\uACFC \uB300\uC751\uD558\uB294 \uD310\uC815\uC744<br>\uD1B5\uD574 \uADF8
      \uCE74\uB4DC \uB300\uC2E0\uD558\uC5EC<br> \uC0AC\uC6A9\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.<br>\uBB34\uC0C9
      \uCE74\uB4DC\uB294 \uC77C\uBD80 \uCE74\uB4DC \uD6A8\uACFC\uB97C<br>\uC5F4\uD654\uB41C
      \uD6A8\uACFC\uB85C \uBC1C\uB3D9\uD569\uB2C8\uB2E4.<br>\uD544\uB4DC\uC5D0\uC11C
      \uBB34\uC0C9 \uCE74\uB4DC\uB97C<br>\uC0AC\uC6A9 \uD560 \uACBD\uC6B0 \uBB34\uC0C9
      \uCE74\uB4DC\uB294<br>\uC18C\uBA78\uD569\uB2C8\uB2E4."
  - buttonName: "\uBB34\uC0C9<br>\uC8FC\uC0AC\uC704"
    displayName: "\uBB34\uC0C9 \uC804\uC6A9 \uC8FC\uC0AC\uC704"
    description: "1~4LV 1D4<br>5~9LV 1D6<br>10LV 1D8<br>\uC704\uC758 \uC8FC\uC0AC\uC704\uB97C<br>\uC0AC\uC6A9\uD569\uB2C8\uB2E4."
  effectEntries:
  - buttonName: "\uC758\uC695"
    displayName: "\uBC84\uD504 : \uC758\uC695"
    description: "\uCD5C\uB300 : 5<br>\uBAA8\uB4E0 \uD310\uC815\uC5D0 +2<br>\uBCF4\uC815\uCE58\uB97C
      \uCD94\uAC00 \uD569\uB2C8\uB2E4.<br>\uBB34\uAE30\uB825\uC744 \uC5BB\uC744 \uACBD\uC6B0<br>\uC218\uCE58
      1\uC744 \uAC10\uC18C \uD558\uC5EC<br>\uC0C1\uC1C4\uD569\uB2C8\uB2E4.<br>\uC804\uD22C
      \uC885\uB8CC\uD574\uB3C4 \uC720\uC9C0\uB429\uB2C8\uB2E4."
  - buttonName: "\uBB34\uAE30\uB825"
    displayName: "\uB514 \uBC84\uD504 : \uBB34\uAE30\uB825"
    description: "\uCD5C\uB300 : 5<br>\uBAA8\uB4E0 \uD310\uC815\uC5D0 -2<br>\uBCF4\uC815\uCE58\uB97C
      \uCD94\uAC00 \uD569\uB2C8\uB2E4.<br>\uC758\uC744 \uC5BB\uC744 \uACBD\uC6B0<br>\uC218\uCE58
      1\uC744 \uAC10\uC18C \uD558\uC5EC<br>\uC0C1\uC1C4\uD569\uB2C8\uB2E4.<br>\uC804\uD22C
      \uC885\uB8CC\uD574\uB3C4 \uC720\uC9C0\uB429\uB2C8\uB2E4."
  - buttonName: "\uAC00\uC18D"
    displayName: "\uBC84\uD504 : \uAC00\uC18D"
    description: "\uCD5C\uB300 : 6<br>\uC911\uCCA9 \uB2F9<br>+5 \uC6B0\uC120\uAD8C\uC744
      \uC5BB\uC2B5\uB2C8\uB2E4.<br>\uC911\uCCA9 2\uB2F9<br>\uB300\uC751 : \uD68C\uD53C\uC5D0
      +1<br>\uBCF4\uC815\uCE58\uB97C \uBD80\uC5EC\uD569\uB2C8\uB2E4.<br>\uC804\uD22C
      \uC885\uB8CC \uC2DC \uD574\uC81C\uB429\uB2C8\uB2E4.<br>\uAD6C\uC18D\uC744 \uC5BB\uC744
      \uACBD\uC6B0 \uC218\uCE581\uC744<br>\uAC10\uC18C \uD558\uC5EC \uC0C1\uC1C4\uD569\uB2C8\uB2E4."
  - buttonName: "\uAD6C\uC18D"
    displayName: "\uBC84\uD504 : \uAD6C\uC18D"
    description: "\uCD5C\uB300 : 5<br>\uC911\uCCA9 \uB2F9<br>-5 \uC6B0\uC120\uAD8C\uC744
      \uC5BB\uC2B5\uB2C8\uB2E4.<br>\uC911\uCCA9 2\uB2F9<br>\uB300\uC751 : \uD68C\uD53C\uC5D0
      -1<br>\uBCF4\uC815\uCE58\uB97C \uBD80\uC5EC\uD569\uB2C8\uB2E4.<br>\uC804\uD22C
      \uC885\uB8CC \uC2DC \uD574\uC81C\uB429\uB2C8\uB2E4.<br>\uAC00\uC18D\uC744 \uC5BB\uC744
      \uACBD\uC6B0 \uC218\uCE581\uC744<br>\uAC10\uC18C \uD558\uC5EC \uC0C1\uC1C4\uD569\uB2C8\uB2E4."
  - buttonName: "\uCD95\uBCF5"
    displayName: "\uBC84\uD504 : \uCD95\uBCF5"
    description: "\uCD5C\uB300 : 1<br>\uD310\uC815\uC744 \uC9C4\uD589 \uD560 \uACBD\uC6B0<br>\uC8FC\uC0AC\uC704\uB97C
      1\uAC1C \uB354 \uAD74\uB824<br>\uC774\uB4DD\uC801 \uACB0\uACFC \uAC12\uC744
      \uC0AC\uC6A9\uD558\uB2C8\uB2E4.<br>\uB77C\uC6B4\uB4DC \uB3D9\uC548 \uC720\uC9C0\uB429\uB2C8\uB2E4.<br>\uC804\uD22C
      \uC885\uB8CC \uD6C4 \uC720\uC9C0 \uB429\uB2C8\uB2E4.<br>\uC800\uC8FC\uAC00
      \uBD80\uC5EC\uB420 \uACBD\uC6B0 \uC218\uCE58<br>1 \uC744 \uAC10\uC18C \uD558\uC5EC
      \uC0C1\uC1C4\uD569\uB2C8\uB2E4."
  - buttonName: "\uC800\uC8FC"
    displayName: "\uB514 \uBC84\uD504 : \uC800\uC8FC"
    description: "\uCD5C\uB300 : 1<br>\uD310\uC815\uC744 \uC9C4\uD589 \uD560 \uACBD\uC6B0<br>\uC8FC\uC0AC\uC704\uB97C
      1\uAC1C \uB354 \uAD74\uB824<br>\uBD88 \uC774\uB4DD\uC801 \uACB0\uACFC \uAC12\uC744
      \uC0AC\uC6A9\uD558\uB2C8\uB2E4.<br>\uB77C\uC6B4\uB4DC \uB3D9\uC548 \uC720\uC9C0\uB429\uB2C8\uB2E4.<br>\uC804\uD22C
      \uC885\uB8CC \uD6C4 \uC720\uC9C0 \uB429\uB2C8\uB2E4.<br>\uCD95\uBCF5\uC774
      \uBD80\uC5EC\uB420 \uACBD\uC6B0 \uC218\uCE58<br>1 \uC744 \uAC10\uC18C \uD558\uC5EC
      \uC0C1\uC1C4\uD569\uB2C8\uB2E4."
  - buttonName: "\uBB34\uBC29\uBE44"
    displayName: "\uB514 \uBC84\uD504 : \uBB34\uBC29\uBE44"
    description: "\uCD5C\uB300 : 10<br>\uD53C\uD574\uB97C \uBC1B\uC744 \uACBD\uC6B0<br>\uC911\uCCA9
      \uB2F9 +2 \uD53C\uD574<br>\uB77C\uC6B4\uB4DC \uC885\uB8CC 1 \uAC10\uC18C<br>\uC804\uD22C
      \uC885\uB8CC \uC2DC \uD574\uC81C "
  - buttonName: "\uC885\uC5B8"
    displayName: "\uD2B9\uC218 \uD0A4\uC6CC\uB4DC"
    description: "\uCD5C\uB300 : 10<br>\uB77C\uC6B4\uB4DC \uC885\uB8CC 1 \uAC10\uC18C<br>\uC885\uC5B8\uC774
      0\uC774\uB418\uBA74 \uC989\uC0AC<br>(\uBCF4\uC2A4 \uC81C\uC678)<br>\uBCF4\uC2A4\uC758
      \uACA8\uC6B0 \uAC15\uB825\uD55C<br>\uB300\uBBF8\uC9C0\uB85C \uBCC0\uACBD<br>\uC804\uD22C
      \uC885\uB8CC \uD574\uC81C"
  etcEntries:
  - buttonName: "\uD310\uC815"
    displayName: "\uD310\uC815"
    description: "\u3141\u3134\u3147\u3139"
